{
  "expo": {
    "name": "MOAI BMU",
    "slug": "moai-bmu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/moai-icon.png",
    "scheme": "moai-bmu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/moai-icon.png",
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "apiRoutes": false
        }
      ],
      "expo-audio",
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "baseUrl": "/BMU_Replit",
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
